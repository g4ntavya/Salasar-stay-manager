# Copy to deploy/salasar.env (git-ignored); push.sh uploads it to ~/salasar/salasar.env on the VM.
PORT=8080
HOST=127.0.0.1
# The https address phones and the admin page use (behind the VM's web server / HTTPS proxy).
PUBLIC_URL=https://media.example.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
