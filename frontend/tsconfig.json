{
  "compilerOptions": {
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strict": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "target": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/firebase/config.ts"
  ],
  "extends": "expo/tsconfig.base"
}
