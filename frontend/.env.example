# Copy to .env and fill in from Firebase console → Project settings → General → Your apps → Web app.
# These are client identifiers, not secrets: security comes from database.rules.json.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# Realtime Database page, top of the Data tab (Singapore region ends in .asia-southeast1.firebasedatabase.app)
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ID photo server on the Oracle VM (leave empty until it is set up; photos wait on the phone).
EXPO_PUBLIC_MEDIA_URL=
